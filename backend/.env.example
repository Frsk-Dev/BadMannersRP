PORT=3001
NODE_ENV=development

# Frontend URL (React dev server or production domain)
FRONTEND_URL=http://localhost:5173

# Backend URL (this server)
BACKEND_URL=http://localhost:3001

# Steam API key - get from https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# JWT secret - any long random string
JWT_SECRET=

# Session secret - any long random string
SESSION_SECRET=

# Website database
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Game server database (for character data)
DB_GAME_NAME=
